# Server
PORT=3001
NODE_ENV=development

# EMS CloudBlitz CRM API base URL (no trailing slash) — required
# Example: https://crm-api.cloudblitz.in
CRM_API_URL=https://crm-api.yourdomain.com

# Gmail account used to send inquiry emails — required
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Inbox that receives landing-page form inquiries — required
INQUIRY_RECIPIENT_EMAIL=leads@yourcompany.com

# Comma-separated frontend URLs allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# optional
# CRM request timeout in milliseconds
CRM_REQUEST_TIMEOUT_MS=10000

# Health check timeout for CRM reachability (milliseconds)
HEALTH_CHECK_TIMEOUT_MS=5000
